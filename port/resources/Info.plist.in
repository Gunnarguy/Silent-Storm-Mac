<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key><string>en</string>
	<key>CFBundleExecutable</key><string>${MACOSX_BUNDLE_EXECUTABLE_NAME}</string>
	<key>CFBundleIconFile</key><string>SilentStorm</string>
	<key>CFBundleIdentifier</key><string>org.silentstorm.mac</string>
	<key>CFBundleInfoDictionaryVersion</key><string>6.0</string>
	<key>CFBundleName</key><string>Silent Storm</string>
	<key>CFBundleDisplayName</key><string>Silent Storm</string>
	<key>CFBundlePackageType</key><string>APPL</string>
	<key>CFBundleShortVersionString</key><string>1.2</string>
	<key>CFBundleVersion</key><string>1</string>
	<key>LSApplicationCategoryType</key><string>public.app-category.strategy-games</string>
	<key>LSMinimumSystemVersion</key><string>14.0</string>
	<key>LSSupportsGameMode</key><true/>
	<key>NSHighResolutionCapable</key><true/>
	<key>NSHumanReadableCopyright</key><string>Silent Storm © 2003 Nival Interactive. Native macOS port of the community reconstruction (noncommercial).</string>
	<key>NSSupportsAutomaticGraphicsSwitching</key><true/>
</dict>
</plist>
